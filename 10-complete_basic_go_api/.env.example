API_ENV=development
API_HTTP_ADDR=:8080
API_STORE=postgres
API_DATABASE_URL=postgres://api:api@localhost:5432/api?sslmode=disable
API_JWT_SECRET=dev-only-secret-change-me-32chars!!
API_JWT_ISSUER=go-api
API_ACCESS_TOKEN_TTL=15m
API_REFRESH_TOKEN_TTL=168h
API_CORS_ORIGINS=http://localhost:3000
API_LOG_LEVEL=info
API_RATE_LIMIT_RPS=10
API_RATE_LIMIT_BURST=20
API_AUTH_RATE_LIMIT_RPS=0.5
API_AUTH_RATE_LIMIT_BURST=5
API_AUTO_MIGRATE=true
API_TRUST_PROXY=false
API_SHUTDOWN_TIMEOUT=10s
API_CLEANUP_INTERVAL=1h
API_REQUEST_TIMEOUT=15s
